# Salin file ini menjadi .env lalu sesuaikan nilainya.
# PowerShell: Copy-Item .env.example .env
# Linux     : cp .env.example .env

# Port web di host (buka http://IP-SERVER:APP_PORT)
APP_PORT=8080

# Port phpMyAdmin (profil "tools" saja)
PMA_PORT=8081

# Zona waktu container
TZ=Asia/Jakarta

# Kredensial database
DB_ROOT_PASSWORD=ganti-password-root-ini
DB_DATABASE=stokbarang
DB_USERNAME=stokbarang
DB_PASSWORD=ganti-password-app-ini
